{
  "name": "maitri-node-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.26.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "prettier --check . && eslint . && tsc --noEmit && vitest run && pnpm test:e2e && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:auth": "vitest run tests/auth-crypto.test.ts tests/auth-service.test.ts tests/auth-routes.test.ts tests/auth-middleware.test.ts tests/otp-service.test.ts tests/error-handler.test.ts tests/redaction.test.ts",
    "test:e2e": "node-pg-migrate up --envPath .env --migrations-dir migrations && RUN_E2E=true vitest run tests/e2e/auth.e2e.test.ts",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate --envPath .env --migrations-dir migrations",
    "migrate:create": "node-pg-migrate create --envPath .env --migrations-dir migrations --migration-file-language ts",
    "migrate:up": "node-pg-migrate up --envPath .env --migrations-dir migrations",
    "migrate:down": "node-pg-migrate down --envPath .env --migrations-dir migrations",
    "migrate:redo": "node-pg-migrate redo --envPath .env --migrations-dir migrations",
    "migrate:dry-run": "node-pg-migrate up --envPath .env --migrations-dir migrations --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "argon2": "0.45.1",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "file-type": "^22.1.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "qrcode": "^1.5.4",
    "twilio": "^6.1.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "26.5.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "7.2.1",
    "eslint": "10.10.0",
    "node-pg-migrate": "9.0.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11"
  }
}
