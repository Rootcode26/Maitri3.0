NODE_ENV=development
PORT=4000
# Number of proxy hops in front of the app (e.g. the Next.js rewrite) so
# express derives the real client IP for rate limiting. Set to 0 if none.
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000
# The app connects using these URLs only. The discrete DB_*/REDIS_* host,
# port and credential vars live in the root .env for docker-compose to
# provision the containers; the app never reads them.
DATABASE_URL=postgresql://maitri_3:CHANGE_ME@localhost:5434/maitri_3
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=5
JWT_ACCESS_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_USE_A_DIFFERENT_32_CHARACTER_SECRET
JWT_ISSUER=maitri-node-backend
JWT_AUDIENCE=maitri-client
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_REMEMBERED_REFRESH_TTL_SECONDS=2592000
OTP_SECRET=CHANGE_ME_USE_A_DIFFERENT_32_CHARACTER_SECRET
OTP_PROVIDER=console
# Set OTP_PROVIDER=twilio and fill in the vars below to send real OTPs via Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_SEND_LIMIT=5
OTP_SEND_WINDOW_SECONDS=300
# Fixed-window rate limit for login and password-reset routes (per client IP).
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
# Development-only fixed OTP. MUST be unset in production (the app refuses to
# boot with NODE_ENV=production while this is set).
OTP_DEVELOPMENT_CODE=123456

# Internal Python rules engine. Leave URL/token blank to use the built-in
# approval derivation (Node falls back automatically if the engine is down).
RULES_SERVICE_URL=
RULES_SERVICE_TOKEN=
RULES_VERSION=2026.09
RULES_SERVICE_TIMEOUT_MS=5000
