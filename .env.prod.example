# =============================================================================
# Maitri 3.0 — PRODUCTION environment (single-box docker compose).
#
# 1. Copy:   cp .env.prod.example .env.prod
# 2. Fill in every value marked CHANGE_ME (see the generation hints below).
# 3. Never commit .env.prod — it is gitignored.
#
# Generate strong secrets on the server:
#   openssl rand -hex 32      # for each *_SECRET and INTERNAL_API_TOKEN
#   openssl rand -hex 16      # for passwords / access keys
# =============================================================================

# --- Public hostname + TLS ---------------------------------------------------
# Publicly resolvable host pointing at this box. No domain? Use sslip.io with
# your EC2 public IP: 13.201.45.6  ->  SITE_HOST=13-201-45-6.sslip.io
SITE_HOST=CHANGE_ME.sslip.io
# Email Let's Encrypt uses for expiry notices (optional but recommended).
ACME_EMAIL=you@example.com

# --- Container images (pin for reproducible builds) --------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
MINIO_IMAGE=quay.io/minio/minio:RELEASE.2025-04-08T15-41-24Z
MINIO_MC_IMAGE=quay.io/minio/mc:RELEASE.2025-04-08T15-39-49Z
CADDY_IMAGE=caddy:2-alpine

# --- PostgreSQL --------------------------------------------------------------
DB_USER=maitri_3
DB_PASSWORD=CHANGE_ME            # openssl rand -hex 16
DB_NAME=maitri_3

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME         # openssl rand -hex 16

# --- Object storage (MinIO) --------------------------------------------------
# MinIO refuses to start if these are too short: ACCESS_KEY_ID >= 3 chars,
# SECRET_ACCESS_KEY >= 8 chars. The openssl hints below produce far longer.
S3_ACCESS_KEY_ID=CHANGE_ME       # openssl rand -hex 16
S3_SECRET_ACCESS_KEY=CHANGE_ME   # openssl rand -hex 24
S3_BUCKET=maitri-documents

# --- Application secrets (min 32 chars each) ---------------------------------
JWT_ACCESS_SECRET=CHANGE_ME      # openssl rand -hex 32
JWT_REFRESH_SECRET=CHANGE_ME     # openssl rand -hex 32  (different from above)
OTP_SECRET=CHANGE_ME             # openssl rand -hex 32
# Shared secret between the Node API and the Python decision service.
INTERNAL_API_TOKEN=CHANGE_ME     # openssl rand -hex 32

# --- Runtime mode + OTP delivery ---------------------------------------------
# The compose file defaults NODE_ENV to `development` and the applicant OTP to a
# fixed 123456 so the demo needs no SMS gateway. In this mode applicants just
# enter 123456 to verify. (Trade-off: auth cookies are not marked Secure.)
#
# For a real production posture instead, uncomment and set:
#   NODE_ENV=production
#   OTP_PROVIDER=twilio
#   TWILIO_ACCOUNT_SID=...
#   TWILIO_AUTH_TOKEN=...
#   TWILIO_PHONE_NUMBER=+1...
# (production forbids the console provider and the fixed OTP code).
#
# NODE_ENV=production
OTP_PROVIDER=console
# OTP_DEVELOPMENT_CODE=123456   # compose already defaults this in dev mode
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
